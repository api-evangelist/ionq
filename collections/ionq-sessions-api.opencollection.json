              },
              {
                "name": "session_id",
                "value": "",
                "type": "query"
              },
              {
                "name": "submitter_id",
                "value": "",
                "type": "query",
                "description": "The id of another user within a shared project to view their submitted jobs. Ignored if not a project member."
              },
