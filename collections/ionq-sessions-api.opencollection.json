            "params": [
              {
                "name": "session_id",
                "value": "",
                "type": "path",
                "description": "The id of the session — this id is provided in the response on session creation."
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          }
